# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGIN=http://localhost:3000

# ── Database (MongoDB Atlas free tier) ───────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wayfarer?retryWrites=true&w=majority

# ── Places (Phase 2) ──────────────────────────────────────────────────────
OPENTRIPMAP_API_KEY=
# OSM Overpass API needs no key — used as a fallback if OpenTripMap fails.

# ── Transport (Phase 3) ───────────────────────────────────────────────────
# Amadeus for Developers self-service (test) API — used for flights and hotels
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
OPENROUTESERVICE_API_KEY=

# ── Hotels (Phase 4) ───────────────────────────────────────────────────────
# Optional: join the free Booking.com Affiliate Program for tracked deep links
BOOKING_AFFILIATE_ID=

# ── Telegram bot (Phase 6) ─────────────────────────────────────────────────
# Public base URL of this backend once deployed, used to register the
# Telegram webhook, e.g. https://wayfarer-ai-backend.onrender.com
TELEGRAM_WEBHOOK_BASE_URL=
# 32-byte (64 hex char) key used to encrypt each user's bot token at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOT_TOKEN_ENCRYPTION_KEY=

# ── LLM for Telegram Q&A (Phase 6) ────────────────────────────────────────
# Provider to be confirmed — e.g. Gemini's free tier. Re-verify current free
# tier terms before committing, since these change.
LLM_API_KEY=
LLM_PROVIDER=gemini
