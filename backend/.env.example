# --- Server ---
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your frontend URL(s))
CORS_ORIGIN=http://localhost:3000

# --- Firebase Admin SDK ---
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste the values from the downloaded JSON here (keep the private key's \n escapes intact).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Geoapify ---
# https://myprojects.geoapify.com/ -> create a project -> API key is instant, no card.
GEOAPIFY_API_KEY=

# --- Groq (LLM for the Telegram bot) ---
# https://console.groq.com/keys -> Create API Key. Free tier, no card.
GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile (Groq's standard
# general-purpose production model) if unset. Override if Groq
# retires/renames it — see https://console.groq.com/docs/models
GROQ_MODEL=

# --- Telegram ---
# Base public URL Telegram will call for webhooks, e.g. your Render service URL.
# Used to build https://<TELEGRAM_WEBHOOK_BASE_URL>/api/telegram/webhook/:userId/:webhookSecret
TELEGRAM_WEBHOOK_BASE_URL=

# --- Secrets ---
# 32-byte (64 hex char) key used to AES-256-GCM encrypt each user's Telegram bot
# token at rest. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
